# Public frontend configuration only.
# NEVER put AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, or other secrets here.

VITE_API_BASE_URL=
VITE_USE_MOCK_API=true
VITE_AWS_REGION=ap-south-1

# Backend-only Hugging Face configuration. Keep HF_TOKEN out of frontend/.env files.
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# Backend-only Google Places API key. Enable Places API (New) in Google Cloud.
GOOGLE_PLACES_API_KEY=
# Optional separate key if Places and Directions use different restricted keys.
GOOGLE_MAPS_API_KEY=
# Keep false unless Google Directions billing is active and explicitly approved.
ENABLE_LIVE_TRAFFIC=false

# Optional DynamoDB persistence. Leave FEEDBACK_TABLE_NAME empty to use local memory.
FEEDBACK_TABLE_NAME=
FEEDBACK_ZONE_TIME_INDEX=zone-time-index
AWS_REGION=ap-south-1

# Place data is sourced from OpenStreetMap via the free Overpass API.
# See: https://overpass-api.de/
